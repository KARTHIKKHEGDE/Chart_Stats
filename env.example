# Copy this to .env and replace the placeholders with your own credentials.
LOCAL_MAX=1
POLYGON_API_KEYS=replace-with-comma-separated-Polygon-keys
POLYGON_RPM=5
SEC_USER_AGENT=Your Name you@example.com
# Optional. If set, the local report prefers Alpaca for today's live bars.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Optional: use a local SSD path, for example D:\gapcache on Windows.
# CACHE_DIR=
